"<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>管理員登入｜今天喝什麼</title><style>*{box-sizing:border-box}body{margin:0;background:#f4f6ef;color:#203b33;font:16px system-ui}main{max-width:460px;margin:10vh auto;padding:28px}h1{font-size:30px}p{line-height:1.7;color:#63746a}a{color:#245d46}form{background:white;border:1px solid #dce4d8;border-radius:14px;padding:24px}label{display:block;margin:16px 0 8px;font-size:14px}input,button{width:100%;font:inherit;padding:13px;border-radius:9px;border:1px solid #cbd8cd}button{margin-top:24px;background:#245d46;color:white;border:0;cursor:pointer}button:disabled{opacity:.5}#error{color:#963f2e;font-size:14px}.hint{font-size:14px}</style></head><body><main><a href=\"/\">返回飲料推薦</a><h1>雲端資料管理</h1><p>輸入管理帳號與密碼，查看收藏及匯出資料。</p><form id=\"login\"><label for=\"username\">帳號</label><input id=\"username\" name=\"username\" autocomplete=\"username\" required maxlength=\"50\" autocapitalize=\"none\" spellcheck=\"false\"><label for=\"password\">密碼</label><input type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" required maxlength=\"256\"><button id=\"submit\" type=\"submit\">登入後台</button><p id=\"error\" role=\"alert\"></p></form><p class=\"hint\">登入有效時間為 8 小時。使用完畢請登出。</p></main><script>document.querySelector('#login').onsubmit=async e=>{e.preventDefault();const button=document.querySelector('#submit'),error=document.querySelector('#error');button.disabled=true;error.textContent='';try{const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:document.querySelector('#username').value,password:document.querySelector('#password').value})});const d=await r.json();if(!r.ok)throw Error(d.message+(d.retry_after?' 約 '+Math.ceil(d.retry_after/60)+' 分鐘後可再試。':''));document.querySelector('#password').value='';location.replace('/admin')}catch(e){error.textContent=e.message||'連線失敗，請重試。';button.disabled=false}};</script></body></html>\n"