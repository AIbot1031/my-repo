"<!doctype html>\n<html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>今天喝什麼｜飲料推薦</title>\n<style>\n:root{font-family:-apple-system,BlinkMacSystemFont,\"Noto Sans TC\",sans-serif;color:#203b33;background:#f4f6ef}*{box-sizing:border-box}body{margin:0}main{max-width:1080px;margin:auto;padding:36px 24px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d5dfd3;padding-bottom:24px}.logo{font-size:19px;font-weight:750}.badge{font-size:12px;background:#e4ecdf;padding:8px 12px;border-radius:20px}h1{font-size:clamp(32px,5vw,50px);letter-spacing:-2px;margin:40px 0 12px}p{color:#63746a;line-height:1.7}.layout{display:grid;grid-template-columns:340px 1fr;gap:28px;margin-top:30px}form{background:white;border:1px solid #dce4d8;padding:26px;border-radius:20px;height:fit-content}label{display:block;font-size:14px;font-weight:600;margin:18px 0 8px}textarea,input,select{font:inherit;width:100%;border:1px solid #ccd7ca;border-radius:10px;padding:12px;background:#fcfdf9;color:#203b33}textarea{min-height:100px;resize:vertical}.check{display:flex;align-items:center;gap:9px;font-weight:400}.check input{width:18px;height:18px}button{font:inherit;cursor:pointer;border:0;border-radius:10px;padding:13px;background:#245d46;color:white;width:100%;margin-top:22px;font-weight:650}button:disabled{opacity:.6;cursor:wait}.hint{font-size:12px;margin-bottom:0}.section-title{display:flex;justify-content:space-between;align-items:center;margin:0 0 16px}h2{font-size:21px;margin:0}.count{font-size:13px;color:#63746a}.card{background:white;border:1px solid #dce4d8;border-radius:16px;padding:22px;margin-bottom:14px;display:flex;gap:16px}.rank{background:#edf2e7;border-radius:12px;min-width:42px;height:42px;display:grid;place-items:center;font-weight:700}.content{flex:1}.title{display:flex;justify-content:space-between;gap:12px}.title h3{font-size:18px;margin:2px 0 8px}.price{white-space:nowrap;font-weight:700;color:#245d46}.type{display:inline-block;font-size:12px;padding:4px 9px;background:#f0f4eb;border-radius:6px}.favorite{width:auto;margin-top:12px;font-size:12px;padding:7px 11px;background:#edf2e7;color:#245d46}.batch-actions{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 18px}.batch-actions button{width:auto;margin:0;padding:11px 18px}.batch-actions .restart{background:#edf2e7;color:#245d46}[hidden]{display:none!important}.actions{display:flex;gap:8px;flex-wrap:wrap}.swap{background:#245d46;color:white}button:disabled{cursor:default}.nutrition{font-size:12px;color:#63746a;line-height:1.7;margin-top:10px}.reason{font-size:14px;margin:10px 0 0}.empty{padding:44px 28px;border:1px dashed #c6d2c0;border-radius:16px;text-align:center;color:#63746a}.warning{color:#9a5c19;font-size:13px}footer{margin-top:35px;font-size:12px;color:#758273}@media(max-width:760px){.layout{grid-template-columns:1fr}main{padding:24px 18px}h1{margin-top:30px}header .badge{font-size:11px}}\n</style></head><body><main>\n<header><div class=\"logo\">◉ 喝點剛好的</div><div style=\"display:flex;gap:10px;align-items:center\"><a id=\"account-link\" href=\"/account\" style=\"color:#245d46;text-decoration:none;font-size:13px\">註冊／登入</a><a class=\"badge\" href=\"/graph\" style=\"color:#245d46;text-decoration:none\">查看異質圖 →</a></div></header><details style=\"margin:20px 0;padding:16px;background:white;border:1px solid #dce4d8;border-radius:12px\"><summary>我的收藏與恢復碼</summary><p id=\"profile-state\">正在讀取收藏…</p><button type=\"button\" id=\"show-code\" style=\"width:auto;margin:0\">顯示我的恢復碼</button><p id=\"recovery-code\" style=\"overflow-wrap:anywhere\" hidden></p><p id=\"recovery-help\">在另一個瀏覽器使用時，輸入先前保存的恢復碼即可接回收藏。請妥善保存，不要分享给其他人。</p><label for=\"restore-code\">恢復碼／舊網站識別碼</label><input id=\"restore-code\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"貼上先前保存的代碼\"><button type=\"button\" id=\"restore-profile\" style=\"width:auto;margin-top:10px\">恢復收藏</button></details>\n<h1>今天，想喝點什麼？</h1><p>說說你的心情和偏好，找到適合這一刻的飲料。</p>\n<div class=\"layout\"><form id=\"form\"><h2>你的飲料偏好</h2><label for=\"query\">今天想喝…</label><textarea id=\"query\" placeholder=\"例如：想喝清爽的飲料，下午想放鬆一下\">想喝清爽的飲料</textarea><label for=\"brand\">想喝哪個品牌</label><select id=\"brand\"><option value=\"\">所有品牌</option></select><label for=\"emotion\">心情 / 需求</label><select id=\"emotion\"><option value=\"一般\">隨意喝一杯</option><option value=\"提神\">提神</option><option value=\"放鬆\">放鬆</option></select><label for=\"budget\">最高預算（NT$）</label><input id=\"budget\" type=\"number\" min=\"0\" max=\"10000\" placeholder=\"不限預算\"><label class=\"check\"><input id=\"caffeine\" type=\"checkbox\">不要咖啡因</label><label class=\"check\"><input id=\"milk\" type=\"checkbox\">避開乳製品</label><button id=\"submit\" type=\"submit\">幫我推薦 →</button><p class=\"hint\"><span id=\"catalog-summary\">正在讀取飲料資料…</span></p></form>\n<section aria-live=\"polite\"><div class=\"section-title\"><h2>為你推薦</h2><span class=\"count\" id=\"count\"></span></div><p id=\"result-note\" class=\"hint\" style=\"margin:0 0 16px\"></p><div class=\"batch-actions\"><button id=\"next-batch\" type=\"button\" hidden>再看一批 ↻</button><button id=\"restart\" class=\"restart\" type=\"button\" hidden>從頭看</button></div><div id=\"results\" class=\"empty\">填好偏好，點「幫我推薦」就能看到結果。</div></section></div><footer>資料來源：你提供的 Excel。價格可能為起價，營養資訊可能依杯型及冷熱不同；風味部分為原表推論。乳製品篩選依奶類線索，原表過敏原欄標題重複，成分仍請向店家確認。 · <a href=\"/admin\">管理後台</a></footer>\n</main><script>\nconst form=document.querySelector('#form'),results=document.querySelector('#results'),button=document.querySelector('#submit');\nconst userId='current';\nfunction node(tag,text,cls){const el=document.createElement(tag);el.textContent=text;if(cls)el.className=cls;return el}\nfetch('/api/catalog').then(r=>r.json()).then(data=>{const info=data.data;document.querySelector('#catalog-summary').textContent='已匯入 '+info.count+' 款飲料 · '+info.brands.length+' 個品牌';for(const brand of info.brands){const option=node('option',brand);option.value=brand;document.querySelector('#brand').append(option)}}).catch(()=>{document.querySelector('#catalog-summary').textContent='讀取資料失敗，請重新整理'});\nlet lastRequest=null, lastSignature=null, seen=new Set(), busy=false, settingsChanged=false, exhausted=false, batchNumber=0;\nconst nextButton=document.querySelector('#next-batch'),restartButton=document.querySelector('#restart');\nconst note=document.querySelector('#result-note');\nfunction setBusy(value){busy=value;button.disabled=value;form.querySelectorAll('input,select,textarea').forEach(el=>el.disabled=value);nextButton.disabled=value||settingsChanged||exhausted;restartButton.disabled=value||settingsChanged;}\nasync function fetchRecommendations(payload){\n  const response=await fetch('/api/recommend',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});\n  const data=await response.json();\n  if(!response.ok||data.status!=='success')throw Error('推薦暫時無法完成，請稍後再試。');\n  return data.data.recommendations;\n}\nfunction renderCard(rec,rank){\n  const card=node('article','','card');card.dataset.drinkId=rec.drink.id;\n  card.append(node('div',String(rank).padStart(2,'0'),'rank'));\n  const content=node('div','','content'),title=node('div','','title'),meta=rec.drink.metadata||{};\n  title.append(node('h3',rec.drink.name),node('span',meta.price_original||(rec.drink.price==null?'價格未提供':'NT$ '+rec.drink.price),'price'));\n  content.append(title,node('span',(meta.brand?meta.brand+' · ':'')+rec.drink.type,'type'),node('p','風味（原表）：'+(meta.flavor||rec.reason),'reason'));\n  content.append(node('p','咖啡因：'+(meta.caffeine_mg==null?'未提供':meta.caffeine_mg+' mg')+' · 熱量：'+(meta.calories_kcal==null?'未提供':meta.calories_kcal+' kcal'),'nutrition'));\n  const details=node('details','');details.append(node('summary','查看資料備註'),node('p',(meta.data_status||'')+' '+(meta.notes||'未提供備註'),'nutrition'));content.append(details);\n  const actions=node('div','','actions'),favorite=node('button','喜歡這款','favorite');favorite.type='button';\n  const message=node('p','','warning');message.hidden=true;\n  favorite.onclick=async()=>{favorite.disabled=true;try{const r=await fetch('/api/favorite',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_id:userId,drink_id:rec.drink.id})});if(!r.ok)throw Error();favorite.textContent='已記錄喜好，下次推薦會參考';profileStatus()}catch(e){favorite.textContent='儲存失敗，請重試';favorite.disabled=false}};\n  actions.append(favorite);content.append(actions,message);if(rec.warning)content.append(node('p',String(rec.warning),'warning'));card.append(content);return card;\n}\nfunction markSettingsChanged(){if(lastRequest){settingsChanged=true;nextButton.disabled=true;restartButton.disabled=true;note.textContent='設定已變更，按「幫我推薦」套用新設定。';}}\nform.addEventListener('input',markSettingsChanged);form.addEventListener('change',markSettingsChanged);\nfunction readSettings(){\n  const constraints={brand:document.querySelector('#brand').value,caffeine_free:document.querySelector('#caffeine').checked,allergens:document.querySelector('#milk').checked?['乳製品']:[]};\n  const budget=document.querySelector('#budget').value;if(budget!=='')constraints.max_price=Number(budget);\n  return {user_id:userId,query:document.querySelector('#query').value,emotion:document.querySelector('#emotion').value,constraints};\n}\nasync function showBatch(payload,reset=false){\n  if(busy)return;\n  const signature=JSON.stringify(payload),same=signature===lastSignature&&!reset;\n  const excluded=same?new Set(seen):new Set();\n  const request=JSON.parse(JSON.stringify(payload));request.constraints.excluded_ids=[...excluded];\n  setBusy(true);button.textContent='正在挑選…';nextButton.textContent='正在換整份榜單…';note.textContent='正在挑選另一批符合設定的飲料…';\n  try{\n    const recs=(await fetchRecommendations(request)).filter(rec=>!excluded.has(rec.drink.id));\n    settingsChanged=false;\n    if(!recs.length&&same&&seen.size){\n      exhausted=true;nextButton.hidden=false;restartButton.hidden=false;\n      note.textContent='符合這組設定的 '+seen.size+' 款飲料已全部看過，已保留最後一批。可調整設定，或按「從頭看」。';\n      return;\n    }\n    lastRequest=JSON.parse(JSON.stringify(payload));lastSignature=signature;seen=excluded;batchNumber=same?batchNumber+1:1;exhausted=false;\n    results.replaceChildren();restartButton.hidden=true;nextButton.hidden=!recs.length;\n    if(!recs.length){results.className='empty';results.textContent='沒有符合目前設定的飲料，請調整預算或飲食限制。';document.querySelector('#count').textContent='';note.textContent='';return;}\n    recs.forEach(rec=>seen.add(rec.drink.id));results.className='';document.querySelector('#count').textContent='第 '+batchNumber+' 批 · '+recs.length+' 款';\n    note.textContent='沿用同一組設定，每次更換整份榜單；已看過 '+seen.size+' 款飲料。';\n    recs.forEach((rec,index)=>results.append(renderCard(rec,index+1)));\n  }catch(err){note.textContent=(err.message||'連線失敗，請再試一次。')+(results.querySelector('.card')?' 已保留原榜單。':'');}\n  finally{setBusy(false);button.textContent='幫我推薦 →';nextButton.textContent=exhausted?'這組設定已看完':'再看一批 ↻';}\n}\nform.addEventListener('submit',e=>{e.preventDefault();showBatch(readSettings());});\nnextButton.onclick=()=>{if(lastRequest&&!settingsChanged&&!exhausted)showBatch(lastRequest);};\nrestartButton.onclick=()=>{if(lastRequest&&!settingsChanged)showBatch(lastRequest,true);};\n\nasync function profileStatus(){try{const r=await fetch('/api/profile');const p=await r.json();if(!r.ok)throw Error();if(p.data.account){document.querySelector('#account-link').textContent='ID：'+p.data.account;document.querySelector('#account-link').setAttribute('aria-label','目前登入 ID：'+p.data.account);document.querySelector('#profile-state').textContent='已登入帳號 '+p.data.account+'，保存 '+p.data.count+' 筆收藏。';for(const selector of ['#show-code','#recovery-code','#restore-code','#restore-profile','#recovery-help','label[for=\"restore-code\"]']){const el=document.querySelector(selector);if(el)el.hidden=true}}else{document.querySelector('#profile-state').textContent='已保存 '+p.data.count+' 筆收藏。收藏會保存在雲端，關閉網頁後仍會保留。'}return p.data}catch(e){document.querySelector('#profile-state').textContent='收藏讀取失敗，請重新整理。'}}document.querySelector('#show-code').onclick=async()=>{const p=await profileStatus();if(p){const el=document.querySelector('#recovery-code');el.textContent=p.recovery_code;el.hidden=false}};\ndocument.querySelector('#restore-profile').onclick=async()=>{const button=document.querySelector('#restore-profile');button.disabled=true;try{const r=await fetch('/api/restore',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:document.querySelector('#restore-code').value.trim()})});if(!r.ok){const e=await r.json();throw Error(e.message||'恢復失敗')}location.reload()}catch(e){document.querySelector('#profile-state').textContent=e.message}finally{button.disabled=false}};\nprofileStatus();\n</script></body></html>\n"