"<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>飲料異質圖</title><style>\n*{box-sizing:border-box}body{margin:0;background:#f4f6ef;color:#203b33;font:15px -apple-system,BlinkMacSystemFont,sans-serif}main{max-width:1380px;margin:auto;padding:28px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d5dfd3;padding-bottom:20px}a{color:#245d46;text-decoration:none}h1{font-size:34px;margin:30px 0 8px}p{color:#63746a;line-height:1.7}form{display:flex;gap:14px;align-items:end;flex-wrap:wrap;margin:24px 0}label{display:block;font-size:13px;margin-bottom:7px}select,input,button{font:inherit;padding:11px;border:1px solid #ccd7ca;border-radius:8px;background:white;color:#203b33}button{background:#245d46;color:white;cursor:pointer;border:0;padding:12px 24px}.legend{display:flex;flex-wrap:wrap;gap:20px;font-size:13px;margin:16px 0}.dot{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:7px}.stats{font-size:13px;color:#63746a}.canvas{background:white;border:1px solid #dce4d8;border-radius:16px;overflow:auto;max-height:720px}svg{min-width:1050px;width:100%;display:block}.node{cursor:pointer}.node text{pointer-events:none;font-size:13px;fill:#203b33}.node rect{stroke-width:1.5}.edge{stroke-opacity:.3;transition:stroke-opacity .15s}.edge.active{stroke-opacity:1;stroke-width:3}#detail{background:white;border:1px solid #dce4d8;padding:18px;border-radius:12px;margin-top:16px;line-height:1.8}footer{font-size:12px;color:#63746a;margin-top:20px}#state{font-size:13px}\n</style></head><body><main><header><strong>喝點剛好的 · 異質關係圖</strong><a href=\"/\">← 回飲料推薦</a></header><details style=\"margin:20px 0;padding:16px;background:white;border:1px solid #dce4d8;border-radius:12px\"><summary>我的收藏與恢復碼</summary><p id=\"profile-state\">正在讀取收藏…</p><button type=\"button\" id=\"show-code\" style=\"width:auto;margin:0\">顯示我的恢復碼</button><p id=\"recovery-code\" style=\"overflow-wrap:anywhere\" hidden></p><p>在另一個瀏覽器使用時，輸入先前保存的恢復碼即可接回收藏。請妥善保存，不要分享给其他人。</p><label for=\"restore-code\">恢復碼／舊網站識別碼</label><input id=\"restore-code\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"貼上先前保存的代碼\"><button type=\"button\" id=\"restore-profile\" style=\"width:auto;margin-top:10px\">恢復收藏</button></details><h1>你的飲料異質圖</h1><p>查看品牌、飲料、茶種、奶類與實際收藏的連結。點選節點會突出相鄰關係。</p>\n<form id=\"filters\"><div><label for=\"brand\">品牌</label><select id=\"brand\"><option value=\"\">所有品牌</option></select></div><div><label for=\"query\">尋找品項</label><input id=\"query\" placeholder=\"例如：紅茶拿鐵\"></div><div><label for=\"limit\">顯示飲料數</label><select id=\"limit\"><option>12</option><option>20</option><option>40</option></select></div><button type=\"submit\">更新圖</button></form>\n<div class=\"stats\" id=\"stats\">正在讀取圖…</div><div class=\"legend\"><span><i class=\"dot\" style=\"background:#8765b7\"></i>使用者</span><span><i class=\"dot\" style=\"background:#245d46\"></i>品牌</span><span><i class=\"dot\" style=\"background:#6f9bb2\"></i>飲料</span><span><i class=\"dot\" style=\"background:#a18135\"></i>茶種</span><span><i class=\"dot\" style=\"background:#c57f91\"></i>奶類</span></div><p id=\"model\"></p><p id=\"state\"></p><div class=\"canvas\"><svg id=\"graph\" role=\"img\" aria-label=\"品牌、飲料、茶種、奶類與使用者關係圖\"></svg></div><div id=\"detail\">點選節點，查看它的連線與 Excel 來源。</div><footer>茶種與奶類沿用 Excel 特徵標記，未標記不代表確認不含該成分。圖中的品牌不是實體分店，奶類與茶種是特徵分類。B 接入官方 RelGT 核心的輕量適配版。Excel 圖預訓練學習品項表示，推薦再參考你的實際收藏。沒有收藏時不產生個人圖推薦。C 路徑停用。</footer></main>\n<script>\nconst ns='http://www.w3.org/2000/svg',svg=document.querySelector('#graph'),colors={user:'#8765b7',brand:'#245d46',drink:'#6f9bb2',tea:'#a18135',milk:'#c57f91'},names={user:'使用者',brand:'品牌',drink:'飲料',tea:'茶種',milk:'奶類'};\nconst userId='current';\nfunction element(tag,attrs,text){const el=document.createElementNS(ns,tag);for(const [k,v] of Object.entries(attrs||{}))el.setAttribute(k,v);if(text!=null)el.textContent=text;return el}\nfunction render(data){svg.replaceChildren();const order=['user','brand','drink','tea','milk'],columns=[110,305,605,905,1130],groups=order.map(t=>data.nodes.filter(n=>n.type===t)),height=Math.max(620,groups[2].length*55+100),positions={};svg.setAttribute('viewBox','0 0 1280 '+height);svg.style.height=height+'px';order.forEach((type,i)=>{svg.append(element('text',{x:columns[i],y:30,'text-anchor':'middle',fill:'#63746a','font-size':14},names[type]));groups[i].forEach((n,j)=>positions[n.id]={x:columns[i],y:75+(height-130)*(j+.5)/Math.max(1,groups[i].length)})});\nconst edgeElements=[];for(const edge of data.edges){const a=positions[edge.source],b=positions[edge.target];if(!a||!b)continue;const line=element('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,stroke:edge.type==='interaction'?colors.user:colors[data.nodes.find(n=>n.id===edge.target).type], 'stroke-width':1.5,class:'edge'});line.append(element('title',{},edge.label+(edge.source_row?' · Excel 第 '+edge.source_row+' 列':'')));svg.append(line);edgeElements.push([edge,line])}\nfor(const n of data.nodes){const pos=positions[n.id],g=element('g',{class:'node',tabindex:0,role:'button','aria-label':names[n.type]+'：'+n.label,transform:'translate('+pos.x+','+pos.y+')'}),width=n.type==='drink'?235:145;g.append(element('rect',{x:-width/2,y:-19,width,height:38,rx:9,fill:colors[n.type]+'15',stroke:colors[n.type]}));const label=n.label.length>16?n.label.slice(0,15)+'…':n.label;g.append(element('text',{'text-anchor':'middle',y:5},label),element('title',{},n.label));const show=()=>{const adjacent=data.edges.filter(e=>e.source===n.id||e.target===n.id);edgeElements.forEach(([edge,line])=>line.setAttribute('class','edge'+(edge.source===n.id||edge.target===n.id?' active':'')));const detail=document.querySelector('#detail');detail.replaceChildren();const title=document.createElement('strong');title.textContent=names[n.type]+'：'+n.label;detail.append(title);const p=document.createElement('div');p.textContent=(n.brand?'品牌：'+n.brand+' · ':'')+(n.source_row?'Excel「綜合飲料特徵」第 '+n.source_row+' 列 · ':'')+adjacent.length+' 條連線';detail.append(p);for(const edge of adjacent){const other=data.nodes.find(x=>x.id===(edge.source===n.id?edge.target:edge.source)),row=document.createElement('div');row.textContent=edge.label+' → '+other.label+(edge.source_column?'（Excel '+edge.source_column+' 欄）':'（實際使用紀錄）');detail.append(row)}};g.onclick=show;g.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();show()}};svg.append(g)}\ndocument.querySelector('#stats').textContent='完整圖：'+data.total_nodes+' 個節點 / '+data.total_edges+' 條關係 · 飲料 '+(data.node_types.drink||0)+' / 品牌 '+(data.node_types.brand||0)+' / 茶種 '+(data.node_types.tea||0)+' / 奶類 '+(data.node_types.milk||0)+' · 本次顯示 '+data.shown_drinks+' / '+data.matching_drinks+' 款符合品項';const model=data.model_status||{};document.querySelector('#model').textContent=model.status==='catalog_pretrained'?'RelGT 輕量模型已完成圖預訓練 · '+model.parameters.toLocaleString()+' 參數 · '+model.config.channels+' 維 / '+model.config.heads+' 頭 / '+model.config.local_num_layers+' 層 · 尚未評估個人推薦準確率':'RelGT 模型尚未完成訓練';document.querySelector('#state').textContent=data.shown_drinks===0?'沒有符合條件的品項。':data.has_history?'已使用你的實際收藏；收藏品項會優先顯示。':'你尚未收藏飲料，因此沒有使用者互動邊。回推薦頁點「喜歡這款」，即可建立連結。';}\nasync function load(){const query=new URLSearchParams({brand:document.querySelector('#brand').value,query:document.querySelector('#query').value,limit:document.querySelector('#limit').value,user_id:userId});try{const response=await fetch('/api/graph?'+query);if(!response.ok)throw Error();const data=await response.json();render(data.data)}catch(e){document.querySelector('#stats').textContent='圖資料讀取失敗，請確認服務已啟動。'}}\ndocument.querySelector('#filters').onsubmit=e=>{e.preventDefault();load()};fetch('/api/catalog').then(r=>r.json()).then(data=>{for(const brand of data.data.brands){const option=document.createElement('option');option.value=brand;option.textContent=brand;document.querySelector('#brand').append(option)}load()}).catch(()=>document.querySelector('#stats').textContent='資料讀取失敗');\n\nasync function profileStatus(){try{const r=await fetch('/api/profile');const p=await r.json();if(!r.ok)throw Error();document.querySelector('#profile-state').textContent='已保存 '+p.data.count+' 筆收藏。收藏會保存在雲端，關閉網頁後仍會保留。';return p.data}catch(e){document.querySelector('#profile-state').textContent='收藏讀取失敗，請重新整理。';}}\ndocument.querySelector('#show-code').onclick=async()=>{const p=await profileStatus();if(p){const el=document.querySelector('#recovery-code');el.textContent=p.recovery_code;el.hidden=false}};\ndocument.querySelector('#restore-profile').onclick=async()=>{const button=document.querySelector('#restore-profile');button.disabled=true;try{const r=await fetch('/api/restore',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:document.querySelector('#restore-code').value.trim()})});if(!r.ok){const e=await r.json();throw Error(e.message||'恢復失敗')}location.reload()}catch(e){document.querySelector('#profile-state').textContent=e.message}finally{button.disabled=false}};\nprofileStatus();\n</script></body></html>\n"